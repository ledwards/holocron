{
  "name": "holocron",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios --device \"iPhone 17 Pro Max\"",
    "expo:start": "expo start --dev-client",
    "expo:start:clear": "expo start --dev-client --clear",
    "expo:ios": "expo start --dev-client --ios",
    "dev:ios": "bash scripts/dev-ios.sh",
    "start": "npm run expo:start",
    "start:clear": "npm run expo:start:clear",
    "metro:8081": "expo start --dev-client --port 8081",
    "metro:8082": "expo start --dev-client --port 8082",
    "ios:8081": "expo start --dev-client --ios --port 8081",
    "ios:8082": "expo start --dev-client --ios --port 8082",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js",
    "rules:test": "jest --config jest.config.js src/lib/rules/__tests__",
    "rules:download": "node scripts/rules/download-rulebook.js",
    "rules:extract": "python3 scripts/rules/extract-structured.py",
    "rules:generate": "node scripts/rules/generate-rules.js --structured=scripts/rules/input/structured.document.json",
    "rules:audit": "node scripts/rules/audit-rules.js",
    "rules:focused-regenerate": "node scripts/rules/focused-regenerate.js",
    "rules:quality-gate": "node scripts/rules/quality-gate.js",
    "rules:llm-clean": "node scripts/rules/llm-clean-rules.js",
    "rules:phase3:text": "node scripts/rules/phase3-text.js",
    "screenshots:release": "node scripts/screenshots/release.js",
    "screenshots:dry-run": "node scripts/screenshots/release.js --dry-run --continue-on-error",
    "test:all": "npm run test:unit && npm run test:e2e",
    "bundle:ios": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios",
    "postversion": "react-native-version --never-amend",
    "rules:extract:legacy": "node scripts/rules/extract-pdf.js",
    "rules:generate:legacy": "node scripts/rules/generate-rules.js",
    "rules:test:extraction": "python3 -m unittest discover -s scripts/rules/tests -v",
    "test:upstream": "jest --config jest.config.js --coverage=false src/models/__tests__/UpstreamCorpus.test.ts",
    "cards:refresh-corpus": "python3 scripts/cards/refresh-upstream-corpus.py"
  },
  "dependencies": {
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/netinfo": "11.1.0",
    "@react-native/babel-preset": "^0.79.2",
    "@react-navigation/bottom-tabs": "^7.3.12",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/stack": "^7.3.1",
    "expo": ">=50.0.0-0 <51.0.0",
    "pdfjs-dist": "^4.10.38",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-asset": "^2.1.1",
    "react-native-blob-util": "^0.19.2",
    "react-native-device-info": "^14.0.4",
    "react-native-elements": "^3.4.3",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-svg-transformer": "^1.1.0",
    "react-native-vector-icons": "^10.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-flow-strip-types": "^7.22.5",
    "@babel/plugin-transform-modules-commonjs": "^7.23.0",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.73.5",
    "@testing-library/react-native": "^12.3.0",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^29.5.5",
    "@types/metro-config": "^0.76.3",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "jest": "^29.7.0",
    "prettier": "^2.4.1",
    "react-native-version": "^4.0.0",
    "react-scripts": "^5.0.1",
    "react-test-renderer": "^18.2.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=16"
  }
}
