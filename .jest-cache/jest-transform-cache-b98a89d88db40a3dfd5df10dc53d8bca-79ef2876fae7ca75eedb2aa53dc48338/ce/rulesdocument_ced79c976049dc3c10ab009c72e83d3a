              "italic": false
            }
          ]
        },
        {
          "type": "paragraph",
          "pageRef": 54,
          "textRuns": [
            {
              "text": "7. Determining Winner and Loser Also note:",
              "bold": false,
              "italic": false
            }
          ]
        },
        {
          "type": "paragraph",
          "pageRef": 54,
          "textRuns": [
            {
              "text": "power segment WILL NOT participate in the battle.",
              "bold": false,
              "italic": false
            }
          ]
        },
        {
          "type": "paragraph",
          "pageRef": 54,
          "textRuns": [
            {
              "text": "• If all presence is remov edfrom either side during the power segment, the battle WILL end immediately.",
              "bold": false,
              "italic": false
            }
          ]
        },
        {
          "type": "paragraph",
          "pageRef": 54,
          "textRuns": [
            {
              "text": "Power Segment",
              "bold": true,
              "italic": false
            },
            {
              "text": "-",
              "bold": false,
              "italic": false
            },
            {
              "text": "Draw Power Destinies",
              "bold": true,
              "italic": false
            },
            {
