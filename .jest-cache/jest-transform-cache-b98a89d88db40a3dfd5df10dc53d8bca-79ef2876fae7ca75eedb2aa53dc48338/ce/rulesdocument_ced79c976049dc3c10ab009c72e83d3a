              "italic": false
            },
            {
              "text": "Mobile Effects",
              "bold": true,
              "italic": false
            },
            {
              "text": "Mobile Effects are identified by their Effect icon in the upper-left corner of their card, and \"Mobile Effect\" in their subtype box. Mobile Effects are deployed during built-in movement function. Where they deploy and how they move is specified within their game text.",
              "bold": false,
              "italic": false
            }
          ]
        },
        {
          "type": "paragraph",
          "pageRef": 82,
          "textRuns": [
            {
              "text": "Effects",
              "bold": true,
              "italic": false
            },
            {
              "text": "-",
