        {
          "type": "paragraph",
          "pageRef": 96,
          "textRuns": [
            {
              "text": "A permanent weapon on a character, vehicle, or starship is considered to be a \"character weapon\", \"vehicle weapon\", or \"starship weapon\", respectively.",
