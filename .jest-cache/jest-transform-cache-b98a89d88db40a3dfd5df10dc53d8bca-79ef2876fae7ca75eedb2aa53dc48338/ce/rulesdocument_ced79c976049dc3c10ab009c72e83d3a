            {
              "text": "Battle Phase",
              "bold": true,
              "italic": false
            },
            {
              "text": "Fourth phase of each turn, in which you may initiate one or more battles against your opponent's characters, vehicles and starships. Also the phase when your characters may attack creatures and when your creatures attack.",
              "bold": false,
              "italic": false
            }
          ]
