        },
        {
          "type": "paragraph",
          "pageRef": 13,
          "textRuns": [
            {
              "text": "Types of Actions",
              "bold": true,
              "italic": false
            },
            {
              "text": "Actions are initiated either as top-level actions or res ponses.",
              "bold": false,
              "italic": false
            },
