        {
          "type": "paragraph",
          "pageRef": 75,
          "textRuns": [
            {
              "text": "Note that while each player is allowed to have the same persona on table, the uniqueness rules still require that they must have different card titles (e.g. if Dark has a Lando card on table, Light may also deploy a Lando card, provided that the card title is different).",
              "bold": false,
              "italic": false
